---
// 옮긴 주소로 바로 넘기는 빈 페이지. ?c= 같은 쿼리와 #앵커도 그대로 넘긴다
// (스크립트가 꺼져 있으면 meta refresh가, 그것도 안 되면 링크가 받는다)
interface Props {
  to: string;
}
const { to } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <title>주소가 옮겨졌습니다</title>
  </head>
  <body>
    <p><a href={to}>새 주소로 이동</a></p>
  </body>
</html>
